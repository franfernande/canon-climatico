{
  "name": "canon-climatico",
  "version": "0.1.0",
  "private": true,
  "description": "Alquiler de campo con un saldo que se reparte según la lluvia de NASA POWER, en Avalanche Fuji",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "demo:fuji": "hardhat run scripts/demo.ts --network fuji",
    "relayer:fuji": "hardhat run scripts/relayer.ts --network fuji",
    "verificar": "node scripts/verificar.ts"
  },
  "overrides": {
    "zod": "4.6.7",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.2"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}
